    \u0432\u0438\u0434\u0430 \u0437\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u0443\u044E
    \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438. \u041F\u041A\u041C
    \u0438 \u041B\u041A\u041C - \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.
